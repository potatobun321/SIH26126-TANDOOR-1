# Dockerfile.orin — Production Edge Deployment for NVIDIA Jetson Orin Nano / AGX Orin
# Part of SIH 2026 Problem Statement SIH26126 (Tikka Techies)
# Target: JetPack 6.0 (L4T r36.3.0) | Ubuntu 24.04 LTS | ROS 2 Jazzy Jalisco

FROM dustynv/ros:jazzy-pytorch-l4t-r36.2.0

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=jazzy
ENV ROS_ROOT=/opt/ros/${ROS_DISTRO}
ENV WORKSPACE=/root/ugv_ws

# 1. System Dependencies & Hardware Communication Packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    python3-pip \
    python3-colcon-common-extensions \
    python3-rosdep \
    can-utils \
    iproute2 \
    v4l-utils \
    libusb-1.0-0-dev \
    ros-${ROS_DISTRO}-robot-localization \
    ros-${ROS_DISTRO}-navigation2 \
    ros-${ROS_DISTRO}-nav2-bringup \
    ros-${ROS_DISTRO}-cv-bridge \
    ros-${ROS_DISTRO}-image-transport \
    ros-${ROS_DISTRO}-sensor-msgs \
    ros-${ROS_DISTRO}-geometry-msgs \
    ros-${ROS_DISTRO}-nav-msgs \
    && rm -rf /var/lib/apt/lists/*

# 2. Python Edge Inference & Telemetry Dependencies
RUN pip3 install --no-cache-dir \
    numpy \
    opencv-python-headless \
    onnx \
    onnxruntime-gpu \
    scipy

# 3. Create Colcon Workspace
WORKDIR ${WORKSPACE}
RUN mkdir -p ${WORKSPACE}/src

# 4. Copy UGV Autonomy ROS 2 Packages
COPY src/ugv_bringup ${WORKSPACE}/src/ugv_bringup
COPY src/ugv_description ${WORKSPACE}/src/ugv_description
COPY src/ugv_localization ${WORKSPACE}/src/ugv_localization
COPY src/ugv_nav2 ${WORKSPACE}/src/ugv_nav2
COPY src/ugv_perception ${WORKSPACE}/src/ugv_perception

# 5. Copy Pretrained Onnx Weights & Deployment Engines
RUN mkdir -p ${WORKSPACE}/models/checkpoints
COPY models/checkpoints/terrain_segmenter.onnx ${WORKSPACE}/models/checkpoints/

# 6. Build Workspace with C++ Traversability Costmap Plugin
SHELL ["/bin/bash", "-c"]
RUN source ${ROS_ROOT}/setup.bash && \
    colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release

# 7. Setup Hardware CAN-bus and Serial Environment Script
COPY <<'EOF' /root/entrypoint.sh
#!/bin/bash
set -e

# Setup ROS 2 Jazzy environment
source /opt/ros/jazzy/setup.bash
source /root/ugv_ws/install/setup.bash

# Configure CAN-bus interface for Roboteq Motor Controllers (if physical CAN interface exists)
if ip link show can0 > /dev/null 2>&1; then
    echo "[EDGE DEPLOY] Initializing CAN-bus can0 @ 1000000 bps..."
    ip link set can0 type can bitrate 1000000 || true
    ip link set can0 up || true
fi

echo "========================================================"
echo " TIKKA TECHIES — SIH26126 AUTONOMOUS RECON DEPLOYMENT"
echo " Target: NVIDIA Jetson Orin Nano (40 TOPS INT8 / 20 TFLOPS)"
echo " Stack: ROS 2 Jazzy | Calibrated IPM | Traversability Costmap"
echo "========================================================"

exec "$@"
EOF

RUN chmod +x /root/entrypoint.sh

ENTRYPOINT ["/root/entrypoint.sh"]
CMD ["ros2", "launch", "ugv_bringup", "outdoor_vertical_slice.launch.py", "headless:=True"]
