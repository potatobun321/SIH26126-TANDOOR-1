<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ugv_bringup</name>
  <version>0.1.0</version>
  <description>Bringup and launch orchestration for Gazebo Harmonic outdoor simulation and ROS 2 bridge</description>
  <maintainer email="tikka_techies@gecjaipur.ac.in">Tikka Techies</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ugv_description</exec_depend>
  <exec_depend>ugv_perception</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
